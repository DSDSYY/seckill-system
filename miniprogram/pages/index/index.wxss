.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  color: #888;
  width: 140rpx;
  flex-shrink: 0;
}

.value {
  color: #333;
  word-break: break-all;
}

.stock {
  margin-left: 20rpx;
  color: #d4380d;
  font-weight: 600;
}

.input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.mini-btn {
  background: #fff7e6;
  color: #d4380d;
  border: 1rpx solid #ffbb96;
}

.seckill-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #ff4d4f, #d4380d);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.seckill-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #faad14;
  font-size: 24rpx;
}

.title {
  display: block;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.line {
  display: flex;
  padding: 6rpx 0;
}

.tips {
  color: #999;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 0 8rpx;
}
.addr-card {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
}

.addr {
  font-size: 26rpx;
  word-break: break-all;
}

.addr-hint {
  display: block;
  margin-top: 8rpx;
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
}

.debug .label {
  vertical-align: top;
}

.debug-text {
  flex: 1;
  color: #fa541c;
  font-size: 22rpx;
  word-break: break-all;
  line-height: 1.5;
}